pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'Dev', url: 'https://github.com/Aditya-Firedrake/Node-app.git'
            }
        }
    }

    post {
        success {
            echo 'Code checkout completed successfully.'
        }
        failure {
            echo 'Code checkout failed.'
        }
    }
}
